---
import "../styles/global.css";
import { squareMilestones } from "../data/square-milestones";

const squaresGridSrc = `${import.meta.env.BASE_URL}squares-grid.svg`;

// One real, descriptive alt per grid (screen readers hear it once), the
// other 8 tiles in each 3x3 arrangement are pure visual repetition —
// aria-hidden so they don't get announced 9 times over.
const gridAlt =
  "A grid of individual squares, tiled around itself in a 3 by 3 arrangement, zooming out until all 9 tiles fill the view, then dissolving into a fresh grid that repeats the same zoom-out - a fractal loop where each square eventually stands for an entire previous grid.";

// Two loops. Loop 1 zooms one square out to a full nine-grid view; loop 2's
// single square stands for that entire finished grid and repeats the move.
const cycleLayers = [
  { layer: "cycle-loop1", src: squaresGridSrc },
  { layer: "cycle-loop2", src: squaresGridSrc },
];

// The footer cites real, sourced figures only ("fact" milestones) — analogy
// entries aren't claims, so they don't need a source. A couple of milestones
// share one underlying deal (e.g. the Tunguz breakdown backs Nvidia,
// Microsoft, and Oracle's figures), so this groups by source rather than
// listing the same citation three times.
const citationGroups = Array.from(
  squareMilestones
    .filter((milestone) => milestone.kind === "fact" && milestone.citation)
    .reduce((groups, milestone) => {
      const citation = milestone.citation!;
      const key = citation.url;
      const existing = groups.get(key);
      if (existing) {
        if (!existing.labels.includes(milestone.statement)) {
          existing.labels.push(milestone.statement);
        }
      } else {
        groups.set(key, {
          source: citation.source,
          url: citation.url,
          labels: [milestone.statement],
        });
      }
      return groups;
    }, new Map<string, { source: string; url: string; labels: string[] }>())
    .values(),
);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>A trillion squares - money invested in AI, one dollar at a time</title>
  </head>
  <body>
    <main>
      <section
        class="zoom-wrapper"
        id="zoom-wrapper"
        aria-label="A zoom through a fractal grid of squares, each square a dollar, ending at worldwide AI spending"
      >
        <div class="zoom-stage" id="zoom-stage">
          {/* No intro panel — the piece opens on the square itself and the
              centred labels do the narrating from there. The heading and
              framing still have to exist for anyone not reading visually:
              this is the page's only h1, it names the page for a screen
              reader, and without it the document would open as an unlabelled
              wall of decorative images. Visually hidden, not deleted. */}
          <div class="visually-hidden">
            <h1>How much has the world bet on AI?</h1>
            <p>
              Every square is a dollar. Scroll to zoom out - and once nine
              grids fill the screen, that whole grid becomes just one square
              in the next zoom-out, so the tally keeps climbing long after
              the shapes loop back to where they started.
            </p>
          </div>
          {
            cycleLayers.map(({ layer, src }, loopIndex) => (
              <div class:list={["cycle", layer]}>
                <div class="square-canvas">
                  <div class="tile-grid">
                    <img src={src} alt="" aria-hidden="true" />
                    <img src={src} alt="" aria-hidden="true" />
                    <img src={src} alt="" aria-hidden="true" />
                    <img src={src} alt="" aria-hidden="true" />
                    <img src={src} alt={loopIndex === 0 ? gridAlt : ""} aria-hidden={loopIndex === 0 ? undefined : "true"} />
                    <img src={src} alt="" aria-hidden="true" />
                    <img src={src} alt="" aria-hidden="true" />
                    <img src={src} alt="" aria-hidden="true" />
                    <img src={src} alt="" aria-hidden="true" />
                  </div>
                </div>
              </div>
            ))
          }
          {/* The readout. Its digits change every animation frame, so the
              whole panel is aria-hidden — announcing it would flood a screen
              reader with thousands of numbers. The statement below is the
              aria-live channel instead: it changes only when the tally
              crosses a named milestone, which is the part worth hearing.
              The label is what makes the number mean anything; without it
              the corner just holds an unexplained figure. */}
          <div class="tally" aria-hidden="true">
            <p class="tally-label">Squares on screen</p>
            <p class="tally-value" id="square-tally">1</p>
          </div>
          <p class="square-statement" id="square-statement" aria-live="polite">
          </p>
          {/* The page's one real navigation landmark: the reduced-motion path
              steps through the same milestones the scroll otherwise scrubs. */}
          <nav class="milestone-nav" id="milestone-nav" aria-label="Milestones">
            <button type="button" id="milestone-prev" class="milestone-btn">
              ◀ Previous
            </button>
            <p class="milestone-label" id="milestone-label" aria-live="polite"></p>
            <button type="button" id="milestone-next" class="milestone-btn">
              Next ▶
            </button>
          </nav>
        </div>
      </section>

      {/* Kept in the document but off the visual page: the zoom is meant to
          end on the final number, not on a wall of references stacked under
          the fixed readout. The citations still need to exist — they back the
          "fact" milestones, they're what the links check crawls, and a screen
          reader still reaches them — so this hides them rather than deleting
          them. */}
      <footer class="citations is-hidden">
        <h2>Sources</h2>
        <ul>
          {
            citationGroups.map((group) => (
              <li>
                <strong>{group.labels.join(" ")}</strong>{" "}
                <a href={group.url} class="citation-link">
                  {group.source}
                </a>
              </li>
            ))
          }
        </ul>
      </footer>
    </main>
    <script>
      import { squareMilestones } from "../data/square-milestones";
      import {
        amountToProgress,
        loopPositionForProgress,
        visibleSquareCount,
      } from "../lib/square-tally";
      import { formatSquares } from "../lib/scale-math";
      import { getScrollProgress, prefersReducedMotion } from "../lib/scroll-state";

      const wrapper = document.querySelector<HTMLElement>("#zoom-wrapper");
      const stage = document.querySelector<HTMLElement>("#zoom-stage");
      const tally = document.querySelector<HTMLElement>("#square-tally");
      const statementEl = document.querySelector<HTMLElement>("#square-statement");
      const prevBtn = document.querySelector<HTMLButtonElement>("#milestone-prev");
      const nextBtn = document.querySelector<HTMLButtonElement>("#milestone-next");
      const milestoneLabel = document.querySelector<HTMLElement>("#milestone-label");
      const cycleEls = Array.from(
        document.querySelectorAll<HTMLElement>(".cycle"),
      );

      // Precomputed once: each milestone's scroll progress, ascending in the
      // same order as squareMilestones (already sorted by amountUSD).
      const milestonesWithProgress = squareMilestones.map((milestone) => ({
        ...milestone,
        progress: amountToProgress(milestone.amountUSD),
      }));

      function findActiveMilestone(progress: number) {
        let active = milestonesWithProgress[0];
        for (const milestone of milestonesWithProgress) {
          if (milestone.progress <= progress) {
            active = milestone;
          } else {
            break;
          }
        }
        return active;
      }

      const STATEMENT_FADE_MS = 260;
      let activeStatementId: string | undefined;

      function setStatement(text: string, instant: boolean): void {
        if (!statementEl) return;
        if (instant) {
          statementEl.textContent = text;
          statementEl.setAttribute("data-active", "");
          return;
        }
        statementEl.removeAttribute("data-active");
        window.setTimeout(() => {
          statementEl.textContent = text;
          statementEl.setAttribute("data-active", "");
        }, STATEMENT_FADE_MS);
      }

      if (wrapper && stage && tally) {
        if (prefersReducedMotion()) {
          // No pin, no scroll-driven zoom — step discretely through the
          // same milestones by a button press or arrow key, rendering one
          // static grid (scale + which loop) per press.
          wrapper.classList.add("reduced-motion");
          let milestoneIndex = 0;

          function showMilestone(index: number): void {
            milestoneIndex = Math.max(
              0,
              Math.min(milestonesWithProgress.length - 1, index),
            );
            const milestone = milestonesWithProgress[milestoneIndex];
            if (!milestone) return;

            const { loopIndex, scale } = loopPositionForProgress(milestone.progress);
            // Matches the layer classes in the markup above. These used to be
            // suffixed "-a" from the old six-layer A/B build, so the lookup
            // matched nothing, no layer ever got is-active, and this path
            // rendered no static grid at all.
            //
            // Clamped to the layers that actually exist. square-tally.ts still
            // models three loops while the page now renders two, so every
            // milestone past ~8.4 billion resolves to loopIndex 2 and would
            // look for a .cycle-loop3 that was removed — leaving this path
            // with no grid at all for the top third of the ladder. Clamping
            // holds those milestones on the furthest-out grid there is.
            const layerNumber = Math.min(loopIndex, cycleEls.length - 1) + 1;
            const activeLayerClass = `cycle-loop${layerNumber}`;
            for (const el of cycleEls) {
              const isActive = el.classList.contains(activeLayerClass);
              el.classList.toggle("is-active", isActive);
              el.style.transform = isActive ? `scale(${scale})` : "";
            }

            // No running tally on this path — the number isn't being scrubbed,
            // so the milestone's own count in the nav label below is the
            // readout, and a second copy of it in the corner would just be
            // the same figure twice. Same square count the animated path's
            // tally would show here, since 1 square === $1.
            setStatement(milestone.statement, true);
            if (milestoneLabel) {
              milestoneLabel.textContent = `${formatSquares(milestone.amountUSD)} squares`;
            }
            if (prevBtn) prevBtn.disabled = milestoneIndex === 0;
            if (nextBtn) {
              nextBtn.disabled =
                milestoneIndex === milestonesWithProgress.length - 1;
            }
          }

          prevBtn?.addEventListener("click", () => {
            showMilestone(milestoneIndex - 1);
          });
          nextBtn?.addEventListener("click", () => {
            showMilestone(milestoneIndex + 1);
          });
          stage.tabIndex = 0;
          stage.addEventListener("keydown", (event) => {
            if (event.key === "ArrowLeft") showMilestone(milestoneIndex - 1);
            if (event.key === "ArrowRight") showMilestone(milestoneIndex + 1);
          });

          showMilestone(0);
        } else {
          const initial = findActiveMilestone(0);
          activeStatementId = initial.id;
          setStatement(initial.statement, true);

          function onScrollFrame(): void {
            const progress = getScrollProgress(wrapper!);
            const count = visibleSquareCount(progress);
            tally!.textContent = formatSquares(count);

            const milestone = findActiveMilestone(progress);
            if (milestone.id !== activeStatementId) {
              activeStatementId = milestone.id;
              setStatement(milestone.statement, false);
            }

            requestAnimationFrame(onScrollFrame);
          }

          requestAnimationFrame(onScrollFrame);
        }
      }
    </script>
  </body>
</html>
